# Copy this file to .env and add your key from Google AI Studio.
GEMINI_API_KEY=

# Optional overrides
# GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
# GEMINI_JUDGE_MODEL=gemini-3.5-flash-lite
# IMAGE_SIZE=2K
# MAX_ATTEMPTS=3
# COMFYUI_URL=http://127.0.0.1:8188
# CATVTON_URL=http://127.0.0.1:8190
# The free Gemini tier cannot generate images, so use a local generator by default:
# DEFAULT_GENERATOR=fashn

# Only when FitShot is reachable from the internet (see DEPLOY.md):
# FITSHOT_ACCESS_KEY=a-long-random-secret
# FITSHOT_CORS_ORIGINS=https://your-app.vercel.app

# Looks worked on at once per lane (local GPU, cloud). GPU work still goes one image at a time.
# LOCAL_WORKERS=2
# CLOUD_WORKERS=2

# FASHN VTON 1.5 is two separate models on the Models page: "this PC" (run-fashn.cmd, photos
# never leave the PC) and "Hugging Face" (nothing downloaded, but every try-on sends the person
# and garment photos to the Space). One never stands in for the other. Create a Read token at
# https://huggingface.co/settings/tokens. A free account gets about 9 try-ons a day.
# HF_TOKEN=hf_...
# Spaces are tried in order until one has room (the official one is often full).
# FASHN_SPACES=merve/fashn-vton-1.5,Nymbo/fashn-vton-1.5,hmajid2301/fashn-vton-1.5,fashn-ai/fashn-vton-1.5
# FASHN_STEPS=30
